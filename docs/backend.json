{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user profile information, including their role.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "User's display name."
        },
        "email": {
          "type": "string",
          "description": "User's email, used for login.",
          "format": "email"
        },
        "role": {
          "type": "string",
          "description": "The user's role in the application.",
          "enum": [
            "Customer",
            "Vendor",
            "Admin"
          ]
        },
        "cafeId": {
          "type": "string",
          "description": "The associated cafe ID, if the user is a Vendor."
        },
        "cafeName": {
          "type": "string",
          "description": "The associated cafe name, if the user is a Vendor."
        },
        "loyaltyPoints": {
          "type": "number",
          "description": "User's loyalty points."
        },
        "createdAt": {
          "type": "object",
          "description": "Timestamp of when the user was created."
        }
      },
      "required": [
        "name",
        "email",
        "role",
        "createdAt"
      ]
    },
    "Cafe": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Cafe",
      "type": "object",
      "description": "Represents a cafe entity within the XLEats application.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the cafe."
        },
        "locationTag": {
          "type": "string",
          "description": "Tag indicating the cafe's location.",
          "enum": [
            "hostel",
            "gate",
            "academic_block",
            "quarters"
          ]
        },
        "isOpen": {
          "type": "boolean",
          "description": "Indicates whether the cafe is currently open."
        },
        "openingTime": {
          "type": "string",
          "description": "The time when the cafe opens, format HH:MM."
        },
        "closingTime": {
          "type": "string",
          "description": "The time when the cafe closes, format HH:MM."
        },
        "avgPrepTimeMins": {
          "type": "number",
          "description": "Average preparation time for orders in minutes."
        },
        "approved": {
          "type": "boolean",
          "description": "Indicates whether the cafe has been approved by an admin."
        },
        "isDisabled": {
          "type": "boolean",
          "description": "Indicates whether the cafe is currently disabled."
        },
        "createdAt": {
          "type": "object",
          "description": "Timestamp representing when the cafe was created."
        }
      },
      "required": [
        "name",
        "locationTag",
        "isOpen",
        "openingTime",
        "closingTime",
        "avgPrepTimeMins",
        "approved",
        "isDisabled",
        "createdAt"
      ]
    },
    "MenuItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MenuItem",
      "type": "object",
      "description": "Represents a menu item offered by a cafe.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the menu item."
        },
        "price": {
          "type": "number",
          "description": "Price of the menu item."
        },
        "isVeg": {
          "type": "boolean",
          "description": "Indicates whether the menu item is vegetarian."
        },
        "isAvailable": {
          "type": "boolean",
          "description": "Indicates whether the menu item is currently available."
        },
        "isPopular": {
          "type": "boolean",
          "description": "Indicates whether the menu item is popular."
        },
        "updatedAt": {
          "type": "object",
          "description": "Timestamp representing when the menu item was last updated."
        }
      },
      "required": [
        "name",
        "price",
        "isVeg",
        "isAvailable",
        "isPopular",
        "updatedAt"
      ]
    },
    "Order": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Order",
      "type": "object",
      "description": "Represents an order placed by a customer.",
      "properties": {
        "customerId": {
          "type": "string",
          "description": "The UID of the customer who placed the order."
        },
        "customerName": {
          "type": "string",
          "description": "Name of the customer who placed the order."
        },
        "cafeId": {
          "type": "string",
          "description": "Reference to Cafe."
        },
        "cafeName": {
          "type": "string",
          "description": "Name of the cafe where the order was placed."
        },
        "items": {
          "type": "array",
          "description": "List of items in the order.",
          "items": {
            "type": "object",
            "properties": {
              "itemId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "quantity": {
                "type": "number"
              },
              "price": {
                "type": "number"
              },
              "isVeg": {
                "type": "boolean"
              }
            },
            "required": [
              "itemId",
              "name",
              "quantity",
              "price",
              "isVeg"
            ]
          }
        },
        "specialInstructions": {
          "type": "string",
          "description": "Any special instructions provided by the customer."
        },
        "deliveryMode": {
          "type": "string",
          "description": "The delivery mode for the order ('pickup' or 'delivery').",
          "enum": [
            "pickup",
            "delivery"
          ]
        },
        "deliveryLocation": {
          "type": "object",
          "description": "The delivery location object.",
          "properties": {
            "type": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "label"
          ]
        },
        "status": {
          "type": "string",
          "description": "The current status of the order.",
          "enum": [
            "placed",
            "accepted",
            "preparing",
            "ready",
            "completed",
            "rejected"
          ]
        },
        "etaMins": {
          "type": "number",
          "description": "Estimated time of arrival in minutes."
        },
        "totalAmount": {
          "type": "number",
          "description": "The total amount of the order."
        },
        "pointsClaimed": {
          "type": "boolean",
          "description": "Whether loyalty points for this order have been claimed."
        },
        "createdAt": {
          "type": "object",
          "description": "Timestamp representing when the order was created."
        },
        "updatedAt": {
          "type": "object",
          "description": "Timestamp representing when the order was last updated."
        }
      },
      "required": [
        "customerName",
        "cafeId",
        "cafeName",
        "items",
        "deliveryMode",
        "status",
        "totalAmount",
        "createdAt",
        "updatedAt",
        "customerId",
        "pointsClaimed"
      ]
    },
    "Announcement": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Announcement",
      "type": "object",
      "description": "Represents an announcement displayed in the application.",
      "properties": {
        "message": {
          "type": "string",
          "description": "The content of the announcement."
        },
        "active": {
          "type": "boolean",
          "description": "Indicates whether the announcement is currently active."
        },
        "createdAt": {
          "type": "object",
          "description": "Timestamp representing when the announcement was created."
        }
      },
      "required": [
        "message",
        "active",
        "createdAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores public user profile data."
    },
    "cafes/{cafeId}": {
      "schema": {
        "$ref": "#/entities/Cafe"
      },
      "description": "Stores cafe information."
    },
    "cafes/{cafeId}/menuItems/{itemId}": {
      "schema": {
        "$ref": "#/entities/MenuItem"
      },
      "description": "Stores menu items for a specific cafe."
    },
    "orders/{orderId}": {
      "schema": {
        "$ref": "#/entities/Order"
      },
      "description": "Stores customer orders."
    },
    "announcements/{announcementId}": {
      "schema": {
        "$ref": "#/entities/Announcement"
      },
      "description": "Stores application-wide announcements."
    }
  }
}
