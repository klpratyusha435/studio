
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@admin.com';
    }

    function getUserProfile(userId) {
        return get(/databases/$(database)/documents/users/$(userId));
    }
    
    function isVendorForCafe(cafeId) {
      let userProfile = getUserProfile(request.auth.uid).data;
      return userProfile != null && userProfile.role == 'Vendor' && userProfile.cafeId == cafeId;
    }


    // ===== COLLECTION RULES =====

    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read, update: if request.auth.uid == userId;
      allow delete: if false;

      match /locations/{locationId} {
        allow read, write, delete: if request.auth.uid == userId;
      }
    }

    match /cafes/{cafeId} {
      allow read: if true;
      allow write: if isAdmin(); // Create, update, delete cafes

      match /menuItems/{itemId} {
        allow read: if true;
        allow write: if isVendorForCafe(cafeId) || isAdmin();
      }
      
      match /orders/{orderId} {
        // Rules for the /cafes/{cafeId}/orders subcollection.
        allow list: if isVendorForCafe(cafeId) || isAdmin();

        // Customers can create their own orders.
        allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
        
        // Customers can read their own orders.
        // Vendors can read orders for their cafe.
        // Admins can read any order.
        allow get: if isAdmin() || isVendorForCafe(cafeId) || (isSignedIn() && resource.data.customerId == request.auth.uid);
        allow update: if isAdmin() || isVendorForCafe(cafeId) || (isSignedIn() && get(/databases/$(database)/documents/cafes/$(cafeId)/orders/$(orderId)).data.customerId == request.auth.uid);
        
        // No one can delete orders from the client.
        allow delete: if false;
      }
    }
    
    // Collection group query rules
    match /{path=**}/orders/{orderId} {
       // Admins can query all orders.
       // Customers can query for their own orders across all cafes.
       allow list: if isAdmin() || (isSignedIn() && request.query.where('customerId', '==', request.auth.uid));
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
