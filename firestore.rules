/**
 * Core Philosophy: This ruleset establishes a "secure by default" posture for the CampusCafe application,
 * with public read access for non-sensitive data. Collections intended for public viewing like `cafes`,
 * `menuItems`, and `announcements` are readable by anyone. All write operations are locked down by default,
 * preventing unauthorized data modification. The `orders` collection is completely private, as it contains
 * sensitive user information and currently lacks the necessary fields for secure, per-user authorization.
 *
 * Data Structure: The data is organized into top-level collections for `cafes`, `orders`, and `announcements`.
 * Menu items are stored in a `menuItems` subcollection under their respective cafe (`/cafes/{cafeId}/menuItems/{itemId}`).
 *
 * Key Security Decisions:
 * - Public Read Access: `cafes`, `menuItems`, and `announcements` are readable by any user, including unauthenticated
 *   ones. This allows browsing of cafes and menus before login.
 * - Default Deny on Writes: All `write` operations are disabled across the board. This is a critical security measure.
 *   Writes should only be enabled for specific roles (e.g., admins, cafe owners) once the data model includes
 *   ownership fields (like `ownerId` or `adminId`).
 * - Orders Locked Down: The `orders` collection is inaccessible for both reads and writes. The schema's use of a
 *   `customerName` string instead of a `customerId` (which should contain the user's auth UID) makes secure
 *   authorization impossible. All access is denied to prevent any user from reading or writing another user's order data.
 *
 * Denormalization for Authorization: This ruleset is designed to work with denormalized ownership data. The primary
 * reason most write operations are disabled is the absence of these denormalized fields (like `ownerId` or `creatorId`)
 * on the documents, which are essential for writing secure rules without expensive `get()` calls.
 *
 * Structural Segregation: The use of separate top-level collections for `cafes`, `orders`, and `announcements`
 * provides clear security boundaries, which these rules enforce.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    /**
     * isSignedIn
     * Checks if the user making the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Allows public read access to all cafe information but denies all write operations.
     * @path /cafes/{cafeId}
     * @allow Any user (list): `list /cafes`
     * @deny Any user (create): `create /cafes/cafe_456` because writes are disabled.
     * @principle Public data should be read-only. Writes require an admin/owner role.
     */
    match /cafes/{cafeId} {
      allow read: if true;
      // CRITICAL: Cannot implement owner-only writes. The 'Cafe' entity is missing an 'ownerId' or 'adminId' field.
      allow write: if false; // TODO: Add owner validation once the schema is updated with an ownership field.

      /**
       * @description Allows public read access to all menu items for a cafe, but denies all write operations.
       * @path /cafes/{cafeId}/menuItems/{itemId}
       * @allow Any user (list): `list /cafes/cafe_123/menuItems`
       * @deny Any user (update): `update /cafes/cafe_123/menuItems/item_abc` because writes are disabled.
       * @principle Subcollection permissions should align with the parent, keeping public data read-only.
       */
      match /menuItems/{itemId} {
        allow read: if true;
        // CRITICAL: Cannot implement owner-only writes. The 'MenuItem' entity is missing an 'ownerId' field.
        allow write: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      }
    }

    /**
     * @description Denies all access to orders. The data model is insecure for authorization.
     * @path /orders/{orderId}
     * @allow No requests are permitted.
     * @deny Any user (create): `create /orders/order_123` because the schema lacks a `customerId` field.
     * @deny Any user (get): `get /orders/order_123` to prevent users from reading each other's orders.
     * @principle Deny all access to collections that cannot be securely associated with a specific user.
     */
    match /orders/{orderId} {
      // CRITICAL: All access is denied. The 'Order' entity is missing a 'customerId' field containing the user's
      // auth UID. Securing orders is impossible without this field. Add a `customerId` to the schema and
      // implement rules based on `isOwner(resource.data.customerId)`.
      allow read, write: if false;
    }

    /**
     * @description Allows public read access to announcements, but denies all write operations.
     * @path /announcements/{announcementId}
     * @allow Any user (list): `list /announcements`
     * @deny Any user (create): `create /announcements/announce_xyz` because writes are disabled.
     * @principle Public data should be read-only. Writes require an admin role.
     */
    match /announcements/{announcementId} {
      allow read: if true;
      // CRITICAL: Cannot implement admin-only writes. The 'Announcement' entity is missing a 'creatorId' or similar field.
      allow write: if false; // TODO: Add admin/role validation once the schema is updated.
    }
  }
}
