/**
 * Core Philosophy: This ruleset establishes a "secure by default" posture for the XLEats application,
 * with public read access for non-sensitive data. Collections intended for public viewing like `cafes`,
 * `menuItems`, and `announcements` are readable by anyone. All write operations are locked down by default,
 * preventing unauthorized data modification. The `orders` collection is now secured based on user roles.
 *
 * Data Structure: The data is organized into top-level collections for `cafes`, `orders`, and `announcements`.
 * Menu items are stored in a `menuItems` subcollection under their respective cafe (`/cafes/{cafeId}/menuItems/{itemId}`).
 * User profiles are stored in the `users` collection.
 *
 * Key Security Decisions:
 * - Public Read Access: `cafes`, `menuItems`, and `announcements` are readable by any user, including unauthenticated
 *   ones. This allows browsing of cafes and menus before login.
 * - Role-Based Writes: Write operations are now controlled by user roles (Admin, Vendor, Customer).
 * - Secure Orders: The `orders` collection is secured. Customers can only create and read their own orders.
 *   Vendors can read and update orders for their assigned cafe. Admins have full access.
 *
 * Denormalization for Authorization: This ruleset is designed to work with denormalized ownership data. The primary
 * reason most write operations are disabled is the absence of these denormalized fields (like `ownerId` or `creatorId`)
 * on the documents, which are essential for writing secure rules without expensive `get()` calls.
 *
 * Structural Segregation: The use of separate top-level collections for `cafes`, `orders`, and `announcements`
 * provides clear security boundaries, which these rules enforce.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Safely get the user's data document from the /users collection.
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    // Safely get the role from a user's data. Returns null if not found.
    function getRole(userId) {
      let userData = getUserData(userId);
      if (userData != null && 'role' in userData) {
        return userData.role;
      }
      return null;
    }
    
    function isAdmin() {
      return isSignedIn() && getRole(request.auth.uid) == 'Admin';
    }
    
    function isVendor() {
       return isSignedIn() && getRole(request.auth.uid) == 'Vendor';
    }

    match /users/{userId} {
      // A user can create and read their own profile document.
      allow read, create: if isOwner(userId);
      // Allow users to update their own profile (for loyalty points)
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Allows public read access to all cafe information. Write operations are restricted
     * to administrators.
     * @path /cafes/{cafeId}
     * @allow Any user (list): `list /cafes`
     * @allow Admin only (write): `create /cafes/cafe_456`
     * @principle Public data should be read-only in production. Writes require an admin/owner role.
     */
    match /cafes/{cafeId} {
      allow read: if true;
      allow write: if isAdmin();

      /**
       * @description Allows public read access to all menu items for a cafe. Write operations are
       * restricted to vendors of that cafe or admins.
       * @path /cafes/{cafeId}/menuItems/{itemId}
       * @allow Any user (list): `list /cafes/cafe_123/menuItems`
       * @allow Vendor/Admin (write): `update /cafes/cafe_123/menuItems/item_abc`
       * @principle Subcollection permissions should align with the parent, keeping public data read-only in production.
       */
      match /menuItems/{itemId} {
        allow read: if true;
        allow write: if isVendor() || isAdmin();
      }
    }

    /**
     * @description Secures the orders collection based on user roles.
     * @path /orders/{orderId}
     */
    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;

      // READ: Get a single document.
      // Allowed if you are the customer, the vendor of the cafe, or an admin.
      allow get: if
        isAdmin() ||
        (isSignedIn() && isOwner(resource.data.customerId)) ||
        (getRole(request.auth.uid) == 'Vendor' && getUserData(request.auth.uid).cafeId == resource.data.cafeId);


      // READ: List documents (queries).
      // This rule is designed to validate queries, not individual documents.
      allow list: if
        isAdmin() ||
        (
          getRole(request.auth.uid) == 'Customer' &&
          request.query.customerId == request.auth.uid
        ) ||
        (
          let userProfile = getUserData(request.auth.uid);
          userProfile.role == 'Vendor' &&
          request.query.cafeId == userProfile.cafeId
        );


      // WRITE: Update a document.
      allow update: if
        isAdmin() ||
        (isSignedIn() && isOwner(resource.data.customerId)) ||
        (
            let userProfile = getUserData(request.auth.uid);
            userProfile.role == 'Vendor' &&
            userProfile.cafeId == resource.data.cafeId
        );
      
      allow delete: if false;
    }

    /**
     * @description Allows public read access to announcements. Write operations are restricted to administrators.
     * @path /announcements/{announcementId}
     * @allow Any user (list): `list /announcements`
     * @allow Admin only (create): `create /announcements/announce_xyz`
     * @principle Public data should be read-only in production. Writes require an admin role.
     */
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
