
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@admin.com';
    }

    function getUserProfile(userId) {
        return get(/databases/$(database)/documents/users/$(userId));
    }

    function isVendorForCafe(cafeId) {
      let userProfile = getUserProfile(request.auth.uid).data;
      return userProfile != null && userProfile.role == 'Vendor' && userProfile.cafeId == cafeId;
    }


    // ===== COLLECTION RULES =====

    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read, update: if request.auth.uid == userId;
      allow delete: if false;

      match /locations/{locationId} {
        allow read, write, delete: if request.auth.uid == userId;
      }
    }

    match /cafes/{cafeId} {
      allow read: if true;
      allow create, delete: if isAdmin(); // Only admins can create/delete cafes
      // Admins can update any field. Vendors can only update 'isOpen' and 'avgPrepTimeMins'.
      allow update: if isAdmin() ||
                     (isVendorForCafe(cafeId) 
                      );

      match /menuItems/{itemId} {
        allow read: if true;
        allow write: if isVendorForCafe(cafeId) || isAdmin();
      }

      match /orders/{orderId} {
          // LIST: Who can query this collection?
          // Admins, vendors of this cafe, and any signed-in user (for their own orders).
          // Customer queries MUST be filtered by `customerId` on the client.
          // The `get` rule below provides the actual document-level security.
          allow list: if isAdmin() || isVendorForCafe(cafeId) || isSignedIn();

          // GET: Who can read a single document?
          allow get: if isAdmin() || isVendorForCafe(cafeId) || (isSignedIn() && resource.data.customerId == request.auth.uid);
          
          // WRITE Operations
          allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
          allow update: if isAdmin() || isVendorForCafe(cafeId);
          allow delete: if false;
      }
    }
    
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // COLLECTION GROUP RULES
    match /{path=**}/orders/{orderId} {
      // This rule enables collection group queries on 'orders'.
      // It is only used by Admins for the analytics page.
      // Individual document reads are still protected by the /cafes/{cafeId}/orders/{orderId} GET rule.
      allow list: if isAdmin();
    }
  }
}
