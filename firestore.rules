/**
 * Core Philosophy: This ruleset establishes a "secure by default" posture for the CampusCafe application,
 * with public read access for non-sensitive data. Collections intended for public viewing like `cafes`,
 * `menuItems`, and `announcements` are readable by anyone. All write operations are locked down by default,
 * preventing unauthorized data modification. The `orders` collection is currently configured for development
 * access and lacks production-ready security.
 *
 * Data Structure: The data is organized into top-level collections for `cafes`, `orders`, and `announcements`.
 * Menu items are stored in a `menuItems` subcollection under their respective cafe (`/cafes/{cafeId}/menuItems/{itemId}`).
 *
 * Key Security Decisions:
 * - Public Read Access: `cafes`, `menuItems`, and `announcements` are readable by any user, including unauthenticated
 *   ones. This allows browsing of cafes and menus before login.
 * - Default Deny on Writes: All `write` operations are disabled across the board. This is a critical security measure.
 *   Writes should only be enabled for specific roles (e.g., admins, cafe owners) once the data model includes
 *   ownership fields (like `ownerId` or `adminId`).
 * - Orders Configured for Development: The `orders` collection is temporarily open for reads, creates, and updates
 *   to facilitate development of the vendor order tracking system. The schema's use of a `customerName` string
 *   instead of a `customerId` (which should contain the user's auth UID) makes secure authorization impossible.
 *
 * Denormalization for Authorization: This ruleset is designed to work with denormalized ownership data. The primary
 * reason most write operations are disabled is the absence of these denormalized fields (like `ownerId` or `creatorId`)
 * on the documents, which are essential for writing secure rules without expensive `get()` calls.
 *
 * Structural Segregation: The use of separate top-level collections for `cafes`, `orders`, and `announcements`
 * provides clear security boundaries, which these rules enforce.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    /**
     * isSignedIn
     * Checks if the user making the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Allows public read access to all cafe information. Write operations are temporarily
     * allowed for development and seeding purposes.
     * @path /cafes/{cafeId}
     * @allow Any user (list): `list /cafes`
     * @allow Any user (create): `create /cafes/cafe_456` (INSECURE - for dev only)
     * @principle Public data should be read-only in production. Writes require an admin/owner role.
     */
    match /cafes/{cafeId} {
      allow read: if true;
      // INSECURE: Temporarily allowing writes for development and seeding.
      // This rule should be replaced with proper authentication checks,
      // for example: `allow write: if isSignedIn() && request.auth.token.isAdmin == true;`
      allow write: if true;

      /**
       * @description Allows public read access to all menu items for a cafe. Write operations are
       * temporarily allowed for development and seeding.
       * @path /cafes/{cafeId}/menuItems/{itemId}
       * @allow Any user (list): `list /cafes/cafe_123/menuItems`
       * @allow Any user (update): `update /cafes/cafe_123/menuItems/item_abc` (INSECURE - for dev only)
       * @principle Subcollection permissions should align with the parent, keeping public data read-only in production.
       */
      match /menuItems/{itemId} {
        allow read: if true;
        // INSECURE: Temporarily allowing writes for development and seeding.
        // This rule should be replaced with proper authentication checks for cafe owners.
        allow write: if true;
      }
    }

    /**
     * @description Allows create, read, and update for orders during development to enable checkout and
     * vendor order tracking functionality.
     * @path /orders/{orderId}
     * @allow Any user (create): `create /orders/order_123` (INSECURE - for dev only)
     * @deny Any user (get): `get /orders/order_123` to prevent users from reading each other's orders (currently open for dev).
     * @principle Deny all access to collections that cannot be securely associated with a specific user.
     */
    match /orders/{orderId} {
      // CRITICAL INSECURE RULE: Temporarily allowing create/read/update for development.
      // The 'Order' entity is missing a 'customerId' field with the user's auth UID,
      // and cafes lack an 'ownerId', which makes secure, per-user and per-vendor authorization impossible.
      // In a production app, this should be:
      // `allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;`
      // `allow read: if isSignedIn() && resource.data.customerId == request.auth.uid;`
      // `allow update: if isSignedIn() && get(/databases/$(database)/documents/cafes/$(request.resource.data.cafeId)).data.ownerId == request.auth.uid;`
      allow read, create, update: if true;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to announcements. Write operations are temporarily
     * allowed for development and seeding.
     * @path /announcements/{announcementId}
     * @allow Any user (list): `list /announcements`
     * @allow Any user (create): `create /announcements/announce_xyz` (INSECURE - for dev only)
     * @principle Public data should be read-only in production. Writes require an admin role.
     */
    match /announcements/{announcementId} {
      allow read: if true;
      // INSECURE: Temporarily allowing writes for development and seeding.
      // This rule should be replaced with proper authentication checks,
      // for example: `allow write: if isSignedIn() && request.auth.token.isAdmin == true;`
      allow write: if true;
    }
  }
}
