
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====

    function isSignedIn() {
      return request.auth != null;
    }

    // Secure and efficient check for the Admin role.
    // Does NOT perform a database read.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@admin.com';
    }

    // Function to get a user's data document.
    // This is the ONLY place we should be performing a `get` for user data inside rules.
    function getUserProfile(userId) {
        return get(/databases/$(database)/documents/users/$(userId));
    }


    // ===== COLLECTION RULES =====

    match /users/{userId} {
      // A user can create their own profile.
      allow create: if request.auth.uid == userId;
      // A user can read and update their own profile.
      allow read, update: if request.auth.uid == userId;
      // No user can delete their profile through the client.
      allow delete: if false;
    }

    match /cafes/{cafeId} {
      // Anyone can read cafe information.
      allow read: if true;
      // Only admins can create, update, or delete cafes.
      allow write: if isAdmin();

      match /menuItems/{itemId} {
        // Anyone can read menu items.
        allow read: if true;
        // Only admins or vendors can write to menu items.
        // NOTE: This rule could be made more specific to check if the vendor belongs to THIS cafe.
        // For now, any authenticated vendor can edit any menu. This is a potential future improvement.
        allow write: if
            let userProfile = getUserProfile(request.auth.uid).data;
            isAdmin() || (userProfile != null && userProfile.role == 'Vendor');
      }
    }

    match /orders/{orderId} {
      // A signed-in user can create an order for themselves.
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;

      // GET (Single Document Read)
      // Efficiently checks roles for reading a single order.
      allow get: if
        let userProfile = getUserProfile(request.auth.uid).data;
        isAdmin() ||
        (isSignedIn() && resource.data.customerId == request.auth.uid) || // Customer who owns the order
        (
          userProfile != null &&
          userProfile.role == 'Vendor' &&
          'cafeId' in userProfile &&
          userProfile.cafeId == resource.data.cafeId // Vendor of the cafe
        );

      // LIST (Query)
      // This is the primary fix. It performs ONE get() and validates the query based on the result.
      allow list: if
        // Admins can list all orders.
        if (isAdmin()) {
          true
        }
        // For all other signed-in users...
        else if (isSignedIn()) {
          let userProfile = getUserProfile(request.auth.uid).data;
          // A user profile MUST exist.
          if (userProfile != null) {
            // If the user is a customer, their query MUST be filtered by their own ID.
            if (userProfile.role == 'Customer') {
              request.query.customerId == request.auth.uid
            }
            // If the user is a vendor, their query MUST be filtered by their cafe's ID.
            else if (userProfile.role == 'Vendor' && 'cafeId' in userProfile) {
              request.query.cafeId == userProfile.cafeId
            }
            // Any other case is disallowed.
            else {
              false
            }
          } else {
            // A user with no profile cannot list any orders.
            false
          }
        }
        // Unauthenticated users cannot list orders.
        else {
          false
        };

      // UPDATE
      // Efficiently checks roles for updating an order.
      allow update: if
        let userProfile = getUserProfile(request.auth.uid).data;
        isAdmin() ||
        (isSignedIn() && resource.data.customerId == request.auth.uid) || // Customer who owns the order
        (
            userProfile != null &&
            userProfile.role == 'Vendor' &&
            'cafeId' in userProfile &&
            userProfile.cafeId == resource.data.cafeId // Vendor of the cafe
        );

      // No one can delete orders from the client.
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      // Anyone can read announcements.
      allow read: if true;
      // Only admins can write announcements.
      allow write: if isAdmin();
    }
  }
}
