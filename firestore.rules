
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@admin.com';
    }

    function getUserProfile(userId) {
        return get(/databases/$(database)/documents/users/$(userId));
    }
    
    function isVendorForCafe(cafeId) {
      let userProfile = getUserProfile(request.auth.uid).data;
      return userProfile != null && userProfile.role == 'Vendor' && userProfile.cafeId == cafeId;
    }


    // ===== COLLECTION RULES =====

    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read, update: if request.auth.uid == userId;
      allow delete: if false;

      match /locations/{locationId} {
        allow read, write, delete: if request.auth.uid == userId;
      }
    }

    match /cafes/{cafeId} {
      allow read: if true;
      allow write: if isAdmin(); // Create, update, delete cafes

      match /menuItems/{itemId} {
        allow read: if true;
        allow write: if isVendorForCafe(cafeId) || isAdmin();
      }
      
    match /{path=**}/orders/{orderId} {
        allow list: if request.auth != null;
        allow get: if request.auth != null &&
    resource.data.customerId == request.auth.uid;
        function isOrderOwner() {
          return isSignedIn() && resource.data.customerId == request.auth.uid;
        }

        function isVendorForOrderCafe() {
          return isSignedIn() &&
            get(/databases/$(database)/documents/cafes/$(resource.data.cafeId))
            .data.vendorIds.hasAny([request.auth.uid]);
        }

        allow read: if
            isAdmin() ||
            isOrderOwner() ||
            isVendorForOrderCafe();

        allow create: if isSignedIn() &&
            request.resource.data.customerId == request.auth.uid;

        allow update: if
            isAdmin() ||
            isVendorForOrderCafe();

        allow delete: if false;
      }