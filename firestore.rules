
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@admin.com';
    }

    function getUserProfile(userId) {
        return get(/databases/$(database)/documents/users/$(userId));
    }

    function isVendorForCafe(cafeId) {
      let userProfile = getUserProfile(request.auth.uid).data;
      return userProfile != null && userProfile.role == 'Vendor' && userProfile.cafeId == cafeId;
    }


    // ===== COLLECTION RULES =====

    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read, update: if request.auth.uid == userId;
      allow delete: if false;

      match /locations/{locationId} {
        allow read, write, delete: if request.auth.uid == userId;
      }
    }

    match /cafes/{cafeId} {
      allow read: if true;
      allow write: if isAdmin(); // Create, update, delete cafes

      match /menuItems/{itemId} {
        allow read: if true;
        allow write: if isVendorForCafe(cafeId) || isAdmin();
      }

      match /orders/{orderId} {
          function isOrderOwner() {
            return isSignedIn() && resource.data.customerId == request.auth.uid;
          }

          function isVendorForThisCafe() {
             let userProfile = getUserProfile(request.auth.uid).data;
             return userProfile != null && userProfile.role == 'Vendor' && userProfile.cafeId == cafeId;
          }

          // GET: Admins, the order owner, and the cafe vendor can get a single order.
          allow get: if isAdmin() || isOrderOwner() || isVendorForThisCafe();

          // LIST: Any signed-in user can query for orders (e.g., a customer for their own, a vendor for their cafe's).
          // The actual filtering (e.g., `where('customerId', '==', uid)`) MUST be done on the client.
          // The `get` rule above prevents unauthorized users from reading the content of individual documents they might discover.
          allow list: if isSignedIn();

          // CREATE: A signed-in user can create an order for themselves.
          allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;

          // UPDATE: Admins and the vendor for the cafe can update an order.
          allow update: if isAdmin() || isVendorForThisCafe();

          // DELETE: No one can delete orders.
          allow delete: if false;
      }
    }
    
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
