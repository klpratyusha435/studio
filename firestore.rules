
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@admin.com';
    }

    function getUserProfile(userId) {
        return get(/databases/$(database)/documents/users/$(userId));
    }
    
    function isVendorForCafe(cafeId) {
      let userProfile = getUserProfile(request.auth.uid).data;
      return userProfile != null && userProfile.role == 'Vendor' && userProfile.cafeId == cafeId;
    }

    // ===== COLLECTION GROUP RULE FOR CUSTOMER 'My Orders' =====
    match /{path=**}/orders/{orderId} {
        // This rule allows the 'collectionGroup' query from the customer's "My Orders" page.
        // It grants permission to LIST documents from the 'orders' collection group IFF the query
        // is constrained to the user's own 'customerId'. This is secure and efficient.
        allow list: if isSignedIn() && request.query.where.customerId == request.auth.uid;
    }


    // ===== COLLECTION RULES =====

    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read, update: if request.auth.uid == userId;
      allow delete: if false;

      match /locations/{locationId} {
        allow read, write, delete: if request.auth.uid == userId;
      }
    }

    match /cafes/{cafeId} {
      allow read: if true;
      allow write: if isAdmin(); // Create, update, delete cafes

      match /menuItems/{itemId} {
        allow read: if true;
        allow write: if isVendorForCafe(cafeId) || isAdmin();
      }
      
      match /orders/{orderId} {
        // CREATE: A customer can create their own order.
        allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;

        // GET: A customer can get their own order. A vendor for that cafe can get it. An admin can get it.
        allow get: if (isSignedIn() && resource.data.customerId == request.auth.uid) || isVendorForCafe(cafeId) || isAdmin();

        // LIST (for Vendors): A vendor can list orders for their own cafe. Admins can list all orders for a cafe.
        allow list: if isVendorForCafe(cafeId) || isAdmin();

        // UPDATE: A vendor or admin can update an order's status.
        allow update: if isVendorForCafe(cafeId) || isAdmin();

        // DELETE: No one can delete orders.
        allow delete: if false;
      }
    }

    match /announcements/{announcementId} {
        allow read: if true;
        allow write: if isAdmin();
    }
  }
}
